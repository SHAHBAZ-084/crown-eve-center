{
  "version": 2,
  "builds": [
    { 
      "src": "frontend/package.json", 
      "use": "@vercel/static-build", 
      "config": { "distDir": "dist" } 
    }
  ],
  "routes": [
    { "src": "^/assets/(.*)", "dest": "frontend/assets/$1" },
    { "src": "^/videos/(.*)", "dest": "frontend/videos/$1" },
    { "src": "^/(.*\\.(js|css|png|jpg|jpeg|svg|gif|ico|json|woff2?|xml|txt|webm|mp4|ogg|mov))$", "dest": "frontend/$1" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
